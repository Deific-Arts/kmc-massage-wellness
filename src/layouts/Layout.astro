---
import Aside from "../components/Aside.astro";
import Footer from "../components/Footer.astro";
import MainNav from "../components/MainNav.astro";
import { siteSchema } from "../shared/schema";

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cactus+Classical+Serif&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
		{title && <title>{title}</title>}
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
	</head>
	<body>
    <kemet-drawer overlay side="right">
      <aside slot="sidebar">
        <Aside company="KMC Massage and Wellness">
          <MainNav />
        </Aside>
      </aside>
      <main slot="body">
        <slot />
        <Footer />
      </main>
    </kemet-drawer>
    <kemet-dialog class="book" close-on-click>
      <div style="height: 80vh;">
        <iframe src="https://kimberlylaughtoncoleman.glossgenius.com/services" style="width: 100%; height: 100%; border: none;"></iframe>
      </div>
    </kemet-dialog>
	</body>
</html>
<script>
  // styles
  import 'kemet-ui/styles/tokens.css';
  import '../styles/base.css';
  import '../styles/cea.css';

  // elements
  import 'kemet-ui/button';
  import 'kemet-ui/drawer';
  import 'kemet-ui/dialog';
  import 'kemet-ui/icon';
  import '../elements/kmc-button/';
  import '../elements/kmc-nav-main';

  // handle app state
  import appStore from '../stores/app';
  import type HTMLKemetDrawerElement from 'kemet-ui/drawer';
  import type HTMLKemetDialogElement from 'kemet-ui/dialog';
  import type HTMLKmcNavMainElement from '../elements/kmc-nav-main';

  const drawer = document.querySelector('kemet-drawer') as HTMLKemetDrawerElement;
  const bookModal = document.querySelector('kemet-dialog.book') as HTMLKemetDialogElement;
  const mainNav = document.querySelector('kmc-nav-main') as HTMLKmcNavMainElement;

  appStore.subscribe((state) => {
    drawer.opened = state.drawerOpened;
    bookModal.opened = state.bookModalOpened;
    mainNav.filled = !state.drawerOpened;
  });

  bookModal.addEventListener('kemet-dialog-closed', () => {
    appStore.setState({ bookModalOpened: false });
  });
</script>

