<kmc-enhancements>
  <section>
    <h2>Enhancements</h2>
    <kmc-carousel>
        <kmc-carousel-slide>
          <div>
            <h3>Cold Stone Face Massage</h3>
            <p>Chilled marble stones to reduce puffiness, ease sinus pressure, and refresh the skin.</p>
          </div>
        </kmc-carousel-slide>
        <kmc-carousel-slide>
          <div>
            <h3>Targeted salt stone massage</h3>
            <p>Concentrated Himalayan salt stone heat to instantly melt knots in your main trouble spot.</p>
          </div>
        </kmc-carousel-slide>
        <kmc-carousel-slide>
          <div>
            <h3>Hydrating Hand therapy</h3>
            <p>A rich, moisture-locking massage to deeply nourish and restore overworked hands.</p>
          </div>
        </kmc-carousel-slide>
        <kmc-carousel-slide>
          <div>
            <h3>Hydrating Foot Therapy</h3>
            <p>An intensive moisturizing treatment to revive dry soles and soothe tired feet.</p>
          </div>
        </kmc-carousel-slide>
        <kmc-carousel-slide>
          <div>
            <h3>Aromatherapy</h3>
            <p>Infuse your session with premium essential oils to deeply calm or energize your senses.</p>
          </div>
        </kmc-carousel-slide>
        <kmc-carousel-slide>
          <div>
            <h3>Aromatherapy Scalp Massage</h3>
            <p>A luxurious scalp massage with aromatic oils to melt away mental tension and headaches.</p>
          </div>
        </kmc-carousel-slide>
        <kmc-carousel-slide>
          <div>
            <h3>CBD Oils</h3>
            <p>Upgrade your massage lotion to premium CBD oil to deeply target inflammation and muscle soreness.</p>
          </div>
        </kmc-carousel-slide>
    </kmc-carousel>
  </section>
</kmc-enhancements>
<style>
  section {
    text-align: center;
    padding: 0 4rem;
    position: relative;
    max-width: calc(var(--app-page-width) + 12rem);
  }

  h2 {
    margin-bottom: 3rem;
  }

  div {
    padding: 1rem;
    border-radius: 1rem;
    border: 2px solid white;
  }

  kmc-carousel {
    --gap: 1rem;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;

    /* Creates positioning context for the scroll buttons */
    anchor-name: --carousel;

    &::-webkit-scrollbar {
      display: none;
    }

    kmc-carousel-track {
      display: flex;
      gap: var(--gap);
      /* animation: slideTwoItems 18s infinite ease-in-out; */
    }

    kmc-carousel-slide {
      flex: 0 0 100%;
      scroll-snap-align: start;

      @media (width > 1024px) {
        /* 50% width minus half the gap ensures exactly 2 items fit per view */
        flex: 0 0 calc(50% - (var(--gap) / 2));
      }
    }

    &::scroll-button(left),
    &::scroll-button(right) {
      position: absolute;
      position-anchor: --carousel;
      align-self: anchor-center;
      cursor: pointer;
      font-size: 6rem;
      line-height: 1;
      padding: 0 0 0.15em;
      border: 0;
      opacity: 0.25;
      background: none;
    }

    &::scroll-button(left):hover,
    &::scroll-button(right):hover {
      opacity: 0.5;
    }

    /* Position and set content for Previous button */
    &::scroll-button(left) {
      content: "‹" / "Previous";
      left: anchor(left);
      margin-left: -3rem;
      margin-top: -0.5rem;
    }

    /* Position and set content for Next button */
    &::scroll-button(right) {
      content: "›" / "Next";
      right: anchor(right);
      margin-right: -3rem;
      margin-top: -0.5rem;
    }

    /* Automatically disables when at the start or end */
    &::scroll-button(*):disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }
  }

  @keyframes slideTwoItems {
    0%, 28% {
      transform: translateX(0);
    }
    33%, 61% {
      transform: translateX(calc(-100% - var(--gap)));
    }
    66%, 94% {
      transform: translateX(calc(-200% - (var(--gap) * 2)));
    }
    100% {
      transform: translateX(calc(-300% - (var(--gap) * 3)));
    }
  }
</style>

