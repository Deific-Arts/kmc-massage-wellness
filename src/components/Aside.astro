---
const { company } = Astro.props;
---

<figure>
  <img src="/logo/light.png" alt="{company} Logo" />
</figure>

<nav class="nav">
  <slot />
</nav>

<style>
  figure {
    display: flex;
    gap: 1rem;
    flex-direction: column;
    margin: 0;
    padding: 2rem 0;
    background-color: white;
  }

  figcaption {
    font-size: 1.5rem;
    padding: 1rem;
  }

  img {
    width: 80%;
    margin: auto;
    object-fit: cover;
  }

  .nav {
    display: flex;
    gap: 1rem;
    flex-direction: column;
    padding: 1rem;

    a {
      font-size: 1.25rem;
      text-decoration: none;
      color: rgb(var(--color-ace));
    }
  }
</style>

